{
  "name": "deepslate-worldgen-mods",
  "version": "0.1.0",
  "description": "Deepslate compatibility patches and density function implementations for Minecraft mods.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./ensity": {
      "types": "./dist/ensity/index.d.ts",
      "default": "./dist/ensity/index.js"
    },
    "./lithostitched": {
      "types": "./dist/lithostitched/index.d.ts",
      "default": "./dist/lithostitched/index.js"
    },
    "./moredfs": {
      "types": "./dist/moredfs/index.d.ts",
      "default": "./dist/moredfs/index.js"
    },
    "./tectonic": {
      "types": "./dist/tectonic/index.d.ts",
      "default": "./dist/tectonic/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "watch": "tsc --watch",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "deepslate": "^0.27.0"
  },
  "dependencies": {
    "fastnoise-lite": "^1.1.1",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/pako": "^2.0.3",
    "deepslate": "^0.27.2",
    "typescript": "^5.6.3"
  },
  "author": "Annhilati",
  "license": "MIT"
}
